{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FFXI Launcher",
  "version": "0.1.0",
  "identifier": "com.rubymatrix.xi-launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FFXI Launcher",
        "width": 920,
        "height": 660,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../playonline.reg": "playonline.reg"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
